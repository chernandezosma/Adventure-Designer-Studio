# enable the log messages (bool): When True, prints informational
# and debug messages to console output. Useful for troubleshooting.
# Set False for silent log messages.
DEBUG=true

# LANGUAGES (list): Active language codes for the application. The codes must
# be in format LC_CC, where LC list Language Code, and CC is Country Code.
# You can check at this website https://simplelocalize.io/data/locales/
# Examples: ['en_EN', 'es_MX', 'ca_ES']
# Note: Requires application restart to apply changes.
LANGUAGES=es_ES,de_DE,en_US,fr_FR,it_IT,pt_PT,ru_RU

# UI_LANGUAGE (str): Active language for the IDE interface. Must be one of the
# codes listed in LANGUAGES (i.e. it must have a translation file). Leave it
# commented out to let the OS locale decide (or en_US when DEBUG=true). The
# Options > Language menu writes this key for you; edit it here to preset it.
# UI_LANGUAGE=en_US

# PROJECTS_DIR (str): Folder new projects are created under. When unset,
# defaults to <home>/ADS-Projects. Each project gets its own subfolder
# (<PROJECTS_DIR>/<slug>/<slug>.ads), leaving room for a per-project assets/.
# A leading "~" or "~/" expands to your home directory; surrounding spaces
# are ignored (so "PROJECTS_DIR= ~/x" is fine).
# PROJECTS_DIR=~/ADS-Projects

# ADS_VERSION (str): Version string shown in the status bar as "ADS <value>".
# Purely cosmetic. When unset it defaults to the built-in version.
# ADS_VERSION=0.4.2

# FONT_SIZE (int): Base font size in pixels for UI calculations.
# ⚠️ CAUTION: Modifying breaks layout and widget positioning.
# Recommended: 10-16px. Test thoroughly before changing.
FONT_SIZE_BASE=14.0f

# FONT_NAME (str): Font family used in GUI.
# ⚠️ CAUTION: Font must exist on system; missing fonts crash UI.
# Use only system-safe fonts: 'DejaVu Sans', 'Ubuntu Mono', etc.
LIGHT_FONT=public/fonts/Roboto/static/Roboto-Light.ttf
MEDIUM_FONT=public/fonts/Roboto/static/Roboto-Medium.ttf
REGULAR_FONT=public/fonts/Roboto/static/Roboto-Regular.ttf

# TOOLTIP_DELAY (int): Delay in milliseconds before tooltip appears on hover.
# Default: 500ms (0 = disabled, recommended minimum 500ms
TOOLTIP_DELAY=0.5

# Manual DPI scale override for X11 setups where SDL3 cannot detect
# HiDPI automatically. Set to your monitor's scale factor (e.g. 2.0
# for 4K at 200%, 1.5 for 150%). Leave commented-out on Wayland /
# macOS / Windows where SDL3 detects the scale automatically.
DISPLAY_SCALE=1.5

